# Copy this file to ".env" (same folder) and fill in your values. ".env" is never committed.

# Message Central VerifyNow (https://www.messagecentral.com) - real OTP SMS.
# Sign up, copy your Customer ID, then either generate an Auth Token in the dashboard
# (preferred) or use your account password. Leave empty for test mode (no SMS, OTP 123456).
MC_CUSTOMER_ID=
MC_AUTH_TOKEN=
MC_PASSWORD=

# Admin login created on the very first start (when the database is new).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# PORT=4100
